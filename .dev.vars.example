# Cloudflare Pages Functions environment variables
# Copy to .dev.vars for local development. Do not commit .dev.vars or production values.

# Contact-delivery integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_URL=

# Private operations AI integration
OPENAI_API_KEY=
OPENAI_MODEL=
# Required before the server-side operations agent can run. Keep this value server-side;
# the public browser pipeline intentionally uses its local fallback unless protected admin access is implemented.
OPS_AGENT_ACCESS_TOKEN=
